[Unit]
Description=DeviceLayoutLab teaching service
After=network.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
WorkingDirectory=REPLACE_WITH_PROJECT_DIRECTORY
ExecStart=REPLACE_WITH_PYTHON_EXECUTABLE backend/app.py --host 127.0.0.1 --port REPLACE_WITH_PORT
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
